# ---- LLM(OpenAI 兼容: DeepSeek / Kimi / Qwen / OpenAI / 中转)----
# 可直接复用 drivecast 的 .env 配置(命名一致)
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=              # 例 https://api.deepseek.com ; OpenAI 官方可留空
LLM_TIMEOUT=300

# ---- TTS(edge-tts 免费)----
# 男声: zh-CN-YunxiNeural(活力) / zh-CN-YunjianNeural(沉稳)
# 女声: zh-CN-XiaoxiaoNeural / zh-CN-XiaoyiNeural
TTS_VOICE=zh-CN-YunxiNeural
TTS_RATE=+6%

# ---- 内容 ----
BRAND=面试充电站            # 频道名,渲染在画面/封面角落
TARGET_DURATION_SEC=100    # 目标视频时长(秒),影响脚本长度

# ---- B站上传(可选,默认关闭)----
BILI_UPLOAD_ENABLED=false
BILI_TID=36                # 分区id, 36=知识·科技; 投稿页可核对
# 浏览器登录 bilibili.com 后从 DevTools→Application→Cookies 复制:
BILI_SESSDATA=
BILI_JCT=                  # 即 bili_jct
BILI_BUVID3=
