# 查找顺序(首个存在者生效): $IVB_ENV_FILE → ./.env → ~/.config/ivb/.env

# ---- LLM(OpenAI 兼容: DeepSeek / Kimi / Qwen / OpenAI / 中转)----
# 可直接复用 drivecast 的 .env 配置(命名一致)
# 注意: 注释请单独成行, 不要写在 KEY= 后面(空值后的注释会被当成配置值)
LLM_MODEL=deepseek-chat
LLM_API_KEY=
# 例 https://api.deepseek.com ; OpenAI 官方可留空
LLM_BASE_URL=
# 单次请求读超时(秒); 建连超时单独配置, 网络不通时快速失败
LLM_TIMEOUT=300
# LLM_CONNECT_TIMEOUT=10
# LLM_TEMPERATURE=0.7
# 显式上限, 防网关默认值截断长章节 JSON(输出被截断时会报错提示调大此值)
# LLM_MAX_TOKENS=
# 客户端层网络/限流重试(429/5xx 优先遵循 Retry-After, 否则指数退避+抖动, 单次等待上限 60s)
# LLM_MAX_RETRIES=2
# ---- 单次运行 LLM 硬上限(可选, 默认不限): 一集/一个系列/一个 Web 任务内累计, 超限即停, 可 --resume 续跑 ----
# LLM_MAX_CALLS_PER_RUN=
# LLM_MAX_TOKENS_PER_RUN=
# ---- 费用预估单价(可选, 币种随账单): 未配置时 ivb series 预估只显示调用次数/token/字符数 ----
# LLM_PRICE_INPUT_PER_1K=
# LLM_PRICE_OUTPUT_PER_1K=
# TTS_PRICE_PER_10K_CHARS=
# ---- 备用模型(可选): 主模型限流/宕机时自动切换 ----
# LLM_FALLBACK_MODEL=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_API_KEY=

# ---- TTS ----
# edge(免费) | doubao(火山引擎豆包, 需下方凭证)
TTS_PROVIDER=edge
# edge 音色: 男 zh-CN-YunxiNeural(活力) / zh-CN-YunjianNeural(沉稳)
#            女 zh-CN-XiaoxiaoNeural / zh-CN-XiaoyiNeural
TTS_VOICE=zh-CN-YunxiNeural
TTS_RATE=+6%
# 主通道重试耗尽/鉴权失败时换备用通道合成该场景(留空=不回退); 常用 doubao→edge(edge 免凭证)
# TTS_FALLBACK_PROVIDER=edge

# ---- 豆包 TTS(TTS_PROVIDER=doubao 时生效, seed-tts-2.0)----
# 火山引擎控制台→豆包语音→API Key 管理; 新版一个 API Key 即可
TTS_DOUBAO_API_KEY=
# 旧版控制台: 改用 App ID + Access Key 一对
# TTS_DOUBAO_APP_KEY=
# TTS_DOUBAO_ACCESS_KEY=
# 云舟(男); 女声 zh_female_vv_uranus_bigtts(Vivi)
TTS_DOUBAO_VOICE=zh_male_m191_uranus_bigtts
# speech_rate [-50,100], 0 为原速
TTS_DOUBAO_RATE=0
# 用 1.0 音色时改 seed-tts-1.0
# TTS_DOUBAO_RESOURCE_ID=seed-tts-2.0
# 以下为高级项, 一般无需改动: 接口地址 / 请求 uid / 音频格式 / 采样率 / 流式单次读超时(秒)
# TTS_DOUBAO_HTTP_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
# TTS_DOUBAO_UID=interview-video-bot
# TTS_DOUBAO_FORMAT=mp3
# TTS_DOUBAO_SAMPLE_RATE=24000
# TTS_DOUBAO_RECV_TIMEOUT=30

# ---- 内容 ----
# 频道名, 渲染在画面/封面角落
BRAND=面试充电站
# 目标视频时长(秒), 影响脚本长度
TARGET_DURATION_SEC=100
# 系列模式: 章节审稿 agent 开关
SERIES_REVIEW=true
# 系列模式: 每章目标时长(秒), 决定上下文切分粒度
SERIES_CHAPTER_SEC=150

# ---- 画面 / 配乐 ----
# 画幅: 16:9(横屏, 默认) | 9:16(竖屏 1080x1920, 适合 B站竖屏/短视频)
VIDEO_ASPECT=16:9
# 横屏基准分辨率与帧率(竖屏时宽高自动对调)
# VIDEO_WIDTH=1920
# VIDEO_HEIGHT=1080
# FPS=30
# 背景音乐文件(mp3/wav/m4a), 留空=不加; 自动循环铺满、低音量、人声压低(ducking)、结尾淡出
BGM_FILE=
# BGM 音量(dB, <=0), 越小越轻
BGM_VOLUME_DB=-18
# 有口播时自动压低 BGM
BGM_DUCKING=true
# 每条字幕最多字数(6-16), 超长句优先在逗号/顿号处拆分
SUBTITLE_MAX_CHARS=16
# 字幕条字号 / 距底边像素 / 半透明底条
# SUBTITLE_FONTSIZE=52
# SUBTITLE_BOTTOM=96
# SUBTITLE_BOX=true
# 成片响度(loudnorm): 目标 LUFS / 真峰值 / 响度范围
# LOUDNESS_I=-16
# LOUDNESS_TP=-1.5
# LOUDNESS_LRA=11

# ---- 字幕字体(可选) ----
# 自动探测失败时指定中文字体, 如 Linux: /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# SUBTITLE_FONT_PATH=

# ---- B站上传(可选,默认关闭)----
BILI_UPLOAD_ENABLED=false
# 分区id, 36=知识·科技; 投稿页可核对
BILI_TID=36
# 浏览器登录 bilibili.com 后从 DevTools→Application→Cookies 复制(BILI_JCT 即 bili_jct):
BILI_SESSDATA=
BILI_JCT=
BILI_BUVID3=

# ---- 输出目录 ----
# 默认 output(相对当前目录); 可写绝对路径或 ~/..., 日志 ivb.log 也写在这里
# OUT_ROOT=

# ---- Web 操作台(可选) ----
# 写操作令牌(请求头 X-IVB-Token)。默认绑 127.0.0.1 不需要; ivb web --host 0.0.0.0 等非回环地址时
# 未设置会在启动时自动生成并打印带 #token= 的链接, 设置后固定使用该值
# WEB_TOKEN=
# 额外允许的 Host 头(逗号分隔, 如反代域名/局域网主机名); 回环名与 --host 本身总是允许
# WEB_ALLOWED_HOSTS=
