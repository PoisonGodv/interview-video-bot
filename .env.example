# ---- LLM(OpenAI 兼容: DeepSeek / Kimi / Qwen / OpenAI / 中转)----
# 可直接复用 drivecast 的 .env 配置(命名一致)
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=              # 例 https://api.deepseek.com ; OpenAI 官方可留空
LLM_TIMEOUT=300

# ---- TTS ----
TTS_PROVIDER=edge          # edge(免费) | doubao(火山引擎豆包, 需下方凭证)
# edge 音色: 男 zh-CN-YunxiNeural(活力) / zh-CN-YunjianNeural(沉稳)
#            女 zh-CN-XiaoxiaoNeural / zh-CN-XiaoyiNeural
TTS_VOICE=zh-CN-YunxiNeural
TTS_RATE=+6%

# ---- 豆包 TTS(TTS_PROVIDER=doubao 时生效, seed-tts-2.0)----
# 火山引擎控制台→豆包语音→API Key 管理; 新版一个 API Key 即可
TTS_DOUBAO_API_KEY=
TTS_DOUBAO_VOICE=zh_male_m191_uranus_bigtts   # 云舟(男); 女声 zh_female_vv_uranus_bigtts(Vivi)
TTS_DOUBAO_RATE=0                             # speech_rate [-50,100], 0 为原速
# TTS_DOUBAO_RESOURCE_ID=seed-tts-2.0          # 用 1.0 音色时改 seed-tts-1.0

# ---- 内容 ----
BRAND=面试充电站            # 频道名,渲染在画面/封面角落
TARGET_DURATION_SEC=100    # 目标视频时长(秒),影响脚本长度

# ---- B站上传(可选,默认关闭)----
BILI_UPLOAD_ENABLED=false
BILI_TID=36                # 分区id, 36=知识·科技; 投稿页可核对
# 浏览器登录 bilibili.com 后从 DevTools→Application→Cookies 复制:
BILI_SESSDATA=
BILI_JCT=                  # 即 bili_jct
BILI_BUVID3=
